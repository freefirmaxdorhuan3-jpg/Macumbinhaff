-- UI Helper Functions
local function createScreenGui()
    local sg = Instance.new("ScreenGui")
    sg.Name = "Macumbinhaff_Hub"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = CoreGui
    return sg
end

local function createFrame(parent, props)
    local f = Instance.new("Frame")
    f.Name = props.Name or "Frame"
    f.Size = props.Size or UDim2.new(0, 100, 0, 100)
    f.Position = props.Position or UDim2.new(0, 0, 0, 0)
    f.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(20, 20, 20)
    f.BorderSizePixel = 0
    f.BackgroundTransparency = props.BackgroundTransparency or 0
    f.Parent = parent
    if props.CornerRadius then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, props.CornerRadius)
        corner.Parent = f
    end
    return f
end

local function createLabel(parent, props)
    local lbl = Instance.new("TextLabel")
    lbl.Name = props.Name or "Label"
    lbl.Size = props.Size or UDim2.new(1, 0, 0, 20)
    lbl.Position = props.Position or UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = props.Text or "Label"
    lbl.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
    lbl.Font = props.Font or Enum.Font.GothamMedium
    lbl.TextSize = props.TextSize or 14
    lbl.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center
    lbl.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
    lbl.Parent = parent
    return lbl
end

local function createButton(parent, props, callback)
    local btn = Instance.new("TextButton")
    btn.Name = props.Name or "Button"
    btn.Size = props.Size or UDim2.new(1, 0, 0, 35)
    btn.Position = props.Position or UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(30, 30, 30)
    btn.Text = props.Text or "Button"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.AutoButtonColor = true
    btn.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        callback(btn)
    end)
    return btn
end

local function createSlider(parent, props, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 50)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local lbl = createLabel(container, {
        Size = UDim2.new(1, 0, 0, 20),
        Text = props.Label,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local valueLbl = createLabel(container, {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 15),
        Text = tostring(props.Value),
        TextColor3 = Config.UI.ColorTheme,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local sliderBg = createFrame(container, {
        Size = UDim2.new(1, 0, 0, 8),
        Position = UDim2.new(0, 0, 0, 35),
        BackgroundColor3 = Color3.fromRGB(50, 50, 50),
        CornerRadius = 4
    })

    local sliderFill = createFrame(sliderBg, {
        Size = UDim2.new((props.Value - props.Min) / (props.Max - props.Min), 0, 1, 0),
        BackgroundColor3 = Config.UI.ColorTheme,
        CornerRadius = 4
    })

    local sliderBtn = createFrame(sliderBg, {
        Size = UDim2.new(0, 15, 0, 15),
        Position = UDim2.new((props.Value - props.Min) / (props.Max - props.Min) - 0.5, 0, 0.5, -7.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        CornerRadius = 8
    })

    local dragging = false
    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            while dragging do
                local mousePos = UserInputService:GetMouseLocation()
                local framePos = sliderBg.AbsolutePosition
                local frameSize = sliderBg.AbsoluteSize
                local x = math.clamp(mousePos.X - framePos.X, 0, frameSize.X)
                local percent = x / frameSize.X
                local val = props.Min + percent * (props.Max - props.Min)
                
                sliderFill.Size = UDim2.new(percent, 0, 1, 0)
                sliderBtn.Position = UDim2.new(percent - 0.5, 0, 0.5, -7.5)
                valueLbl.Text = tostring(math.floor(val))
                callback(val)
                
                RunService.Heartbeat:Wait()
                if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    dragging = false
                end
            end
        end
    end)

    return container
end

local function createColorPicker(parent, props, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 40)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local lbl = createLabel(container, {
        Size = UDim2.new(1, -50, 1, 0),
        Text = props.Label,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local colorBtn = createFrame(container, {
        Size = UDim2.new(0, 40, 1, 0),
        Position = UDim2.new(1, -40, 0, 0),
        BackgroundColor3 = props.Color,
        CornerRadius = 5
    })

    colorBtn.MouseButton1Click:Connect(function()
        local palette = {
            Color3.fromRGB(0, 255, 127),
            Color3.fromRGB(255, 0, 255),
            Color3.fromRGB(0, 127, 255),
            Color3.fromRGB(255, 255, 0),
            Color3.fromRGB(255, 127, 0),
            Color3.fromRGB(255, 255, 255)
        }
        local currentIdx = table.find(palette, props.Color) or 1
        local nextIdx = (currentIdx % #palette) + 1
        local newColor = palette[nextIdx]
        
        colorBtn.BackgroundColor3 = newColor
        callback(newColor)
    end)

    return container
end

